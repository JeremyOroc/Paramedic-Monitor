# TEMPLATE ONLY -- never put real values in this file. It is committed to git.
# Real values belong in .env.local, which is gitignored.
#
#   cp .env.example .env.local     then fill in .env.local
#   vercel env pull .env.local     or pull the real production values
#
# --- Supabase -------------------------------------------------------------
# Project Settings -> API in the Supabase dashboard.

# Public. Compiled into the browser bundle and visible to every visitor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Server-side only -- bypasses RLS entirely (full read/write on the
# whole database). Never add a NEXT_PUBLIC_ prefix to this. Doing so would ship
# unrestricted database access to every visitor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Geoapify -------------------------------------------------------------
# Address autocomplete. geoapify.com -> API Keys.
# Public and unprotected, so restrict it to your domains in the Geoapify
# dashboard or it can be scraped and used against your quota.
NEXT_PUBLIC_GEOAPIFY_API_KEY=
